{
  "env": {},
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Agent",
      "Write",
      "Edit",
      "Bash(mkdir *)",
      "Bash(jq *)",
      "Bash(date *)",
      "Bash(test *)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find .worklog *)",
      "Bash(find teams *)",
      "Bash(find .claude *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git worktree list)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .git*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git worktree remove --force *)",
      "Bash(chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"${CLAUDE_PROJECT_DIR:-.}/.worklog/$(date +%Y%m)\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_PROJECT_DIR:-.}/.worklog/$(date +%Y%m)\"; mkdir -p \"$D\" && jq -r '\"[\" + (now | todate) + \"] \" + .prompt' >> \"$D/session-ledger.md\" 2>/dev/null || echo 'WARN: session-ledger hook failed (jq missing?)' >&2",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "D=\"${CLAUDE_PROJECT_DIR:-.}/.worklog/$(date +%Y%m)\"; mkdir -p \"$D\" && jq '{ts: now, reason: .reason, transcript_path: .transcript_path}' > \"$D/compact-checkpoint.json\" 2>/dev/null || echo 'WARN: compact-checkpoint hook failed (jq missing?)' >&2",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -d \"${CLAUDE_PROJECT_DIR:-.}/.worklog/$(date +%Y%m)\" || echo 'WARN: worklog dir missing for this month' >&2",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
